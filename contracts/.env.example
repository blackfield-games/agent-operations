BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=
DEPLOYER_PRIVATE_KEY=

# $BLCKFLD address. Clanker-deployed, empty until launch cast.
BLCKFLD_ADDRESS=

# EAS on Base — OP predeploy slots, see research-clanker-base.md
EAS_ADDRESS=0x4200000000000000000000000000000000000021
EAS_SCHEMA_REGISTRY=0x4200000000000000000000000000000000000020

# Clanker v4 factory on Base, see research-clanker-base.md
CLANKER_FACTORY=0xE85A59c628F7d27878ACeB4bf3b35733630083a9

# --- deploy (script/Deploy.s.sol) ---
# Ownable owner handed all four contracts (two-step; must acceptOwnership after deploy).
# Defaults to the broadcasting deployer when unset.
OWNER_ADDRESS=
# Render-job coordinator: authorized as RenderReceipts coordinator, ComputeMeter spender,
# and ArtifactTemplate minter. Defaults to the broadcasting deployer when unset.
COORDINATOR_ADDRESS=
# $BLCKFLD required to claim a RegionAuthority region (wei). Default 100000 ether.
REGION_STAKE_REQUIRED=
# ERC-1155 base URI for ArtifactTemplate. Default https://artifacts.blackfield.xyz/{id}.json
ARTIFACT_BASE_URI=
